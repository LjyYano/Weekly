---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeadPreload from '../components/HeadPreload.astro';
import Card from '../components/Card.astro';
import Header from '../components/Header/Header.astro';
import { SITE } from '@/config';
import { sortPosts } from '@/util';

const posts = Object.values(import.meta.glob('./posts/*.md', { eager: true })) as any[];
const allPosts = sortPosts(posts);
---

<BaseLayout title={SITE.title} description={SITE.description} pageURL={SITE.homePage} markdownUrl='/index.md'>
  <style slot='head'>
    /* Enhanced card hover effects */
    .card-content:hover {
      transform: translateY(-4px);
      box-shadow:
        0 8px 16px -2px rgb(0 0 0 / 0.12),
        0 4px 8px -2px rgb(0 0 0 / 0.08);
    }

    .card-content:hover img {
      transform: scale(1.02);
    }

    .card-content:active {
      transform: translateY(-2px);
    }
  </style>

  <HeadPreload slot='head' allPosts={allPosts} />

  <Header layout='feed' />
  <div class='feed-container mx-auto -mt-5 mb-12'>
    <div class='grid gap-4 sm:gap-5 pt-4 sm:pt-5 grid-cols-1 sm:grid-cols-2 pad:grid-cols-3 wide:grid-cols-4'>
      {allPosts.map((post, index) => <Card post={post} priority={index <= 2} isLCP={index <= 2} />)}
    </div>
  </div>
</BaseLayout>
