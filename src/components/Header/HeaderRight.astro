---
import { SITE } from '@/config';
import HeaderLink from './HeaderLink.astro';
import Search from './Search.astro';
import { getLangFromUrl } from '../../i18n/utils';

const { blogPage, twitterId, githubId } = SITE;
const lang = getLangFromUrl(Astro.url);
const languageHref = lang === 'en' ? '/' : '/en';
const languageLabel = lang === 'en' ? '中文' : 'EN';
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<div class='flex-grow text-right flex items-center justify-end gap-4'>
  <HeaderLink href={blogPage} target='_blank' class='hidden md:inline-flex'>Blog</HeaderLink>
  <HeaderLink href={`https://x.com/${twitterId}`} target='_blank' class='lg:inline-flex hidden'>Twitter</HeaderLink>
  <HeaderLink href={`https://github.com/${githubId}`} target='_blank' class='hidden md:inline-flex'>GitHub</HeaderLink>
  <HeaderLink href={rssHref} target='_blank' class='hidden md:inline-flex' title='RSS'>RSS</HeaderLink>
  <HeaderLink href={languageHref}>{languageLabel}</HeaderLink>
  <Search />
</div>
